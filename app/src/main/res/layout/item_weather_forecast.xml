<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/padding_small"
    app:cardCornerRadius="@dimen/corner_radius"
    app:cardElevation="@dimen/padding_small"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardBackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/padding_normal">


        <ImageView
            android:id="@+id/imageWeatherIcon"
            android:layout_width="@dimen/weather_icon_size"
            android:layout_height="@dimen/weather_icon_size"
            android:contentDescription="@string/weather_icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@tools:sample/avatars" />

        <TextView
            android:id="@+id/textDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/padding_normal"
            android:textSize="@dimen/text_size_body"
            android:textStyle="bold"
            android:textColor="@color/text_on_gradient"
            app:layout_constraintStart_toEndOf="@id/imageWeatherIcon"
            app:layout_constraintTop_toTopOf="@id/imageWeatherIcon"
            app:layout_constraintBottom_toBottomOf="@id/imageWeatherIcon"
            tools:text="15 мар" />

        <TextView
            android:id="@+id/textTemperature"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_size_price"
            android:textStyle="bold"
            android:textColor="@color/text_on_gradient"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="☀️ -3.5°C" />

        <TextView
            android:id="@+id/textDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_small"
            android:textSize="@dimen/text_size_body"
            android:textColor="@color/text_secondary"
            app:layout_constraintStart_toStartOf="@id/imageWeatherIcon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imageWeatherIcon"
            tools:text="overcast clouds" />

        <TextView
            android:id="@+id/textExtra"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_small"
            android:textSize="@dimen/text_size_small"
            android:textColor="@color/text_secondary"
            app:layout_constraintStart_toStartOf="@id/textDescription"
            app:layout_constraintTop_toBottomOf="@id/textDescription"
            tools:text="💧 78%  •  🌬 3.2 м/с" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>